{
  "name": "package.json",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:prod": "vite build",
    "preview": "vite preview",
    "preview:prod": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "deploy:check": "npm run build:prod && npm run preview:prod",
    "analyze": "vite build --mode analyze",
    "prune": "npm prune --production=false"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.34.0",
    "@vueform/multiselect": "^2.6.11",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "flatpickr": "^4.6.13",
    "pinia": "^3.0.3",
    "sortablejs": "^1.15.6",
    "tailwindcss": "^3.4.17",
    "vue": "^3.5.17",
    "vue-flatpickr-component": "^12.0.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue3-select": "^0.1.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.32",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "terser": "^5.44.0",
    "typescript": "~5.8.0",
    "vite": "^7.1.9",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.10"
  }
}
